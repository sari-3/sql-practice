# Copy this file to .env and fill in your own details: one setting per line.
# Put a value in single quotes if it contains a space, a hash or a dollar sign.
# .env is listed in .gitignore, so it never goes into Git.
PGHOST=your-host
PGPORT=5432
PGDATABASE=your-database
PGUSER=your-username
PGPASSWORD=your-password
MY_PREFIX=xx_
